#!/usr/bin/env bash
# pre-commit — the bilingual documentation gate, over staged files.
#
# Installed with a single command, because this repository has no package.json:
#   git config core.hooksPath githooks
#
# It checks parity between docs/ru and docs/en, verifies every term against the contract,
# and enforces co-change: an edit to a Russian chapter must carry its English counterpart
# in the same commit.
#
# To bypass deliberately: git commit --no-verify. But when a term is legitimate, adding it
# with a reason to scripts/parity-allow.json is more honest than a silent bypass.
set -uo pipefail

command -v node >/dev/null 2>&1 || exit 0
[ -f scripts/check-parity.mjs ] || exit 0

node scripts/check-parity.mjs --staged || {
  echo ""
  echo "Commit stopped by the documentation gate."
  exit 1
}
