# Репозиторий публичный: его клонируют и форкают. Полагаться на глобальный gitignore
# разработчика нельзя — то, что не попало сюда, однажды уедет в историю навсегда.

# IDE и редакторы
.idea/
.vscode/
*.iml
*.swp
*.swo
*~

# Инструменты разработки
.claude/
.cursor/
.aider*

# ОС
.DS_Store
Thumbs.db
desktop.ini

# Локальное и временное
tmp/
temp/
*.log
*.bak
*.orig
*.rej

# Секреты — в этом репозитории их быть не должно вовсе,
# строки ниже страхуют от случайного `git add -A`
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets.*
credentials.*

# Зависимости примеров кода
node_modules/
vendor/
__pycache__/
*.pyc
.venv/
venv/
